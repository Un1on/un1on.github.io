# Скопіюйте цей файл як .env та задайте власні значення.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# DB_PATH не обов'язковий. За замовчуванням використовується ./data/portfolio.sqlite
